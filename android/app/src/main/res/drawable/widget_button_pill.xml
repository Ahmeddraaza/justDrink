<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Frosted glass effect: semi-transparent dark replaces iOS ultraThinMaterial.
         This ensures white text is readable on both white bg (0% fill)
         and blue water bg (high fill). -->
    <solid android:color="#40000000" />
    <stroke android:color="#66FFFFFF" android:width="1dp" />
    <corners android:radius="100dp" />
</shape>
