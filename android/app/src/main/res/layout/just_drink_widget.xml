<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!--
        Water fill: ClipDrawable fills from the BOTTOM upward edge-to-edge.
        Level 0 = empty, 10000 = full. Set via setImageLevel in the provider.
        This matches the iOS bottom-up water fill appearance.
    -->
    <ImageView
        android:id="@+id/widget_water_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_water_clip"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Drop icon: right-aligned, vertically centered -->
        <ImageView
            android:id="@+id/widget_drop_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/widget_icon_blue"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="4dp"
            android:alpha="0.9" />

        <!-- Left content wrapped in a vertical LinearLayout to prevent overlapping -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/widget_drop_icon"
            android:layout_marginEnd="6dp">

            <!-- Time clock -->
            <TextClock
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:textColor="#1A1C1E"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <!-- Intake text -->
            <TextView
                android:id="@+id/widget_intake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0ml / 2500ml (0 Glass)"
                android:textColor="#B31A1C1E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="2dp" />

            <!-- Add Glass button -->
            <Button
                android:id="@+id/widget_add_glass"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="+ Add Glass"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/widget_button_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:minHeight="0dp"
                android:minWidth="0dp" />

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
